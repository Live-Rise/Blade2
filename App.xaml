<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Blade2.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 顺序即依赖：框架控件资源 = 设计令牌 = 排版 = 控件样式（Styles 的 BasedOn 依赖前两者） -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Theme/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/Typography.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
