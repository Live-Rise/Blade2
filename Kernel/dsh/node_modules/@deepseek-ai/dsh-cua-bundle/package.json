{
  "name": "@deepseek-ai/dsh-cua-bundle",
  "description": "Optional macOS Computer Use and permission setup",
  "version": "0.2.2-rc.3",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/cua-bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-computer-use": "0.2.2-rc.3",
    "@deepseek-ai/dsh-cua": "0.2.2-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-include": "~1.1.0",
    "js-yaml": "^4.2.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-experimental-cua-macos": "0.2.2-rc.3"
  }
}