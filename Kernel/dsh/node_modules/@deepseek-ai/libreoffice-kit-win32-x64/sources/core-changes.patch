diff --git a/vcl/inc/skia/dsh_ganesh.hxx b/vcl/inc/skia/dsh_ganesh.hxx
new file mode 100644
index 000000000..2053f7c0a
--- /dev/null
+++ b/vcl/inc/skia/dsh_ganesh.hxx
@@ -0,0 +1,34 @@
+// GPU-only copies from LibreOffice's existing Ganesh context to acquired display images.
+#pragma once
+#include <SkSurface.h>
+class VirtualDevice;
+namespace office_ganesh {
+// Borrowed handles remain owned by the acquired frame-forwarding surface.
+struct Target {
+    void* native;
+    void* sharedHandle;
+    int width;
+    int height;
+};
+// Count final-surface readbacks separately from internal document bitmap operations.
+class OutputScope {
+public:
+    explicit OutputScope(VirtualDevice& device);
+    ~OutputScope();
+    OutputScope(const OutputScope&) = delete;
+    OutputScope& operator=(const OutputScope&) = delete;
+};
+void observeReadback(const SkSurface* surface);
+void observeBitmapExtraction(const SkSurface* surface);
+bool initialized();
+bool healthy();
+// Validate GPU drawing and shared-image import before loading a document.
+void initialize();
+// Borrow the matching D3D11 device on Windows; IOSurface producers need no device.
+void* producerDevice();
+// Exercise platform import/copy using a temporary shared image.
+void probeSurface(const sk_sp<SkSurface>& surface);
+// Returns only after the GPU copy completes; never reads output pixels on the CPU.
+void copy(VirtualDevice& device, const Target& target);
+void copySurface(const sk_sp<SkSurface>& surface, const Target& target);
+}
diff --git a/vcl/inc/skia/dsh_graphite.hxx b/vcl/inc/skia/dsh_graphite.hxx
new file mode 100644
index 000000000..8ee6ed679
--- /dev/null
+++ b/vcl/inc/skia/dsh_graphite.hxx
@@ -0,0 +1,40 @@
+// Process-local Graphite rendering for native document and slideshow output.
+#pragma once
+#include <SkImage.h>
+#include <SkSurface.h>
+#include <webgpu/webgpu.h>
+#include <string>
+class VirtualDevice;
+class SkiaSalGraphicsImpl;
+namespace office_graphite {
+void initialize(WGPUInstance instance, WGPUDevice device, WGPUQueue queue, size_t cacheBytes);
+void shutdown();
+bool enabled();
+bool isGraphite(const sk_sp<SkImage>& image);
+sk_sp<SkSurface> createSurface(const SkImageInfo& info, const SkSurfaceProps* properties);
+sk_sp<SkSurface> wrapTexture(WGPUTexture texture);
+bool flush(bool wait);
+bool healthy();
+/** Cause of the first failure that made the backend unusable; empty while it is healthy. */
+std::string failure();
+// Records a device-lost notification delivered through the WebGPU device descriptor callback.
+void deviceLost(WGPUDeviceLostReason reason, const char* message);
+// Retains the most recent uncaptured WebGPU error as context for a later device-lost notification.
+void deviceError(const char* message);
+// Called only on the VCL thread; detaches pending canvases from a failed recorder.
+void retireLostDevice();
+sk_sp<SkImage> rasterImage(sk_sp<SkImage> image);
+bool readSurface(sk_sp<SkSurface> surface, SkBitmap& bitmap);
+void observeSnapshot(const SkSurface* surface);
+void report();
+// A binding changes only this device; intermediate document devices keep their own targets.
+class Target {
+    SkiaSalGraphicsImpl* implementation = nullptr;
+public:
+    Target(VirtualDevice& device, WGPUTexture texture);
+    ~Target();
+    Target(const Target&) = delete;
+    Target& operator=(const Target&) = delete;
+    void finish();
+};
+}
