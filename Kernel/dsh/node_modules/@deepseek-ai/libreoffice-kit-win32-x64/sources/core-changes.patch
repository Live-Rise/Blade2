+void VclPhysicalFontCollectionTest::testAttributeMatchIsIndependentOfInsertionOrder()
+{
+    // These unknown families have identical attributes and no configured
+    // preference. Reversing hash-table insertion must not change the winner.
+    std::array<OUString, 3> aNames{ u"Tie Alpha"_ustr, u"Tie Beta"_ustr, u"Tie Gamma"_ustr };
+    do
+    {
+        vcl::font::PhysicalFontCollection aFontCollection;
+        for (const auto& rName : aNames)
+        {
+            auto* pFamily = std::get<0>(aFontCollection.FindOrCreateFontFamily(
+                GetEnglishSearchFontName(rName)));
+            FontAttributes aAttributes;
+            aAttributes.SetFamilyName(rName);
+            aAttributes.SetFamilyType(FAMILY_SWISS);
+            aAttributes.SetWeight(WEIGHT_NORMAL);
+            pFamily->AddFontFace(new TestFontFace(aAttributes, FONTID));
+        }
+        auto* pSelected = aFontCollection.FindFontFamilyByAttributes(
+            ImplFontAttrs::SansSerif, WEIGHT_NORMAL, WIDTH_NORMAL, ITALIC_NONE, u"");
+        CPPUNIT_ASSERT(pSelected);
+        CPPUNIT_ASSERT_EQUAL(u"tiealpha"_ustr, pSelected->GetSearchName());
+    }
+    while (std::next_permutation(aNames.begin(), aNames.end()));
+}
