+                    if (mime != "text/plain;charset=utf-8" && mime != "text/html") throw std::runtime_error("Unsupported editor paste type");
+                    diagnosticStage("paste-begin");
+                    if (!document->pClass->paste(document, mime.c_str(), text.data(), text.size())) throw std::runtime_error("Editor paste failed");
+                    diagnosticStage("paste-returned");
+                    settle(*state, document, output);
+                    diagnosticStage("paste-idle-ready");
+                } else if (operation == "key") {
+                    const int key = bounded(value, "key", 0, 65535);
+                    document->pClass->postKeyEvent(document, bounded(value, "type", 0, 1), bounded(value, "character", 0, 0x10ffff), keyCode == 1281 ? keyCode : key);
+                    settle(*state, document, output);
+                } else if (operation == "mouse") {
+                    document->pClass->postMouseEvent(document, bounded(value, "type", 0, 2), bounded(value, "x", 0, INT_MAX), bounded(value, "y", 0, INT_MAX),
+                        bounded(value, "count", 1, 3), bounded(value, "buttons", 0, 7), bounded(value, "modifiers", 0, 65535));
+                    settle(*state, document, output);
+                } else if (operation == "composition") {
+                    const auto text = value.get<std::string>("text");
+                    diagnosticStage("composition-begin");
+                    document->pClass->postWindowExtTextInputEvent(document, 0, bounded(value, "type", 0, 2), text.c_str());
+                    diagnosticStage("composition-returned");
+                    settle(*state, document, output);
+                    diagnosticStage("composition-idle-ready");
+                } else if (operation == "viewport") {
+                    const int zoom = bounded(value, "pixelSize", 1, 65536), twips = bounded(value, "twipSize", 1, 1000000);
+                    if (render) render->viewport(bounded(value, "x", 0, INT_MAX), bounded(value, "y", 0, INT_MAX), zoom, twips);
+                    document->pClass->setClientZoom(document, zoom, zoom, twips, twips);
+                    document->pClass->setClientVisibleArea(document, bounded(value, "x", 0, INT_MAX), bounded(value, "y", 0, INT_MAX),
+                        bounded(value, "width", 1, INT_MAX), bounded(value, "height", 1, INT_MAX));
+                    settle(*state, document, output);
+                } else if (operation == "part") {
+                    document->pClass->setPart(document, bounded(value, "part", 0, document->pClass->getParts(document) - 1));
+                    settle(*state, document, output); info(document, reply);
+                } else if (operation == "selection") {
+                    const auto mime = value.get<std::string>("mime");
+                    if (mime != "text/plain;charset=utf-8" && mime != "text/html") throw std::runtime_error("Unsupported selection type");
+                    reply.put("text", take(document->pClass->getTextSelection(document, mime.c_str(), nullptr)));
+                } else if (operation == "values") {
+                    const auto command = value.get<std::string>("command");
+                    if (command != ".uno:SheetGeometryData" && command != ".uno:ViewRowColumnHeaders" && command != ".uno:CharFontName") throw std::runtime_error("Unsupported editor query");
+                    std::string query = command;
+                    if (command == ".uno:ViewRowColumnHeaders") {
+                        query += "?x=" + std::to_string(bounded(value, "x", 0, INT_MAX)) + "&y=" + std::to_string(bounded(value, "y", 0, INT_MAX))
+                            + "&width=" + std::to_string(bounded(value, "width", 1, INT_MAX)) + "&height=" + std::to_string(bounded(value, "height", 1, INT_MAX));
+                    }
+                    reply.put("value", take(document->pClass->getCommandValues(document, query.c_str())));
+                } else if (operation == "paint") {
+                    const int width = bounded(value, "pixelWidth", 1, 4096), height = bounded(value, "pixelHeight", 1, 4096);
+                    pixels.resize(static_cast<size_t>(width) * height * 4);
+                    if (pixels.size() > maxOutputBytes) throw std::runtime_error("Editor paint exceeds output limit");
+                    paintView(value, [&] {
+                        document->pClass->paintTile(document, pixels.data(), width, height, bounded(value, "x", 0, INT_MAX), bounded(value, "y", 0, INT_MAX),
+                            bounded(value, "width", 1, INT_MAX), bounded(value, "height", 1, INT_MAX));
+                    });
+                    dsh::editor::straightRgba(pixels, document->pClass->getTileMode(document));
+                    reply.put("pixelWidth", width); reply.put("pixelHeight", height); reply.put("pixelFormat", "rgba-straight");
+                } else if (operation == "save") {
+                    const auto path = value.get<std::string>("path"), url = value.get<std::string>("url"), format = value.get<std::string>("format");
+                    if (format != "docx" && format != "xlsx" && format != "pptx") throw std::runtime_error("Unsupported editor export format");
+                    const std::filesystem::path destination(std::u8string(path.begin(), path.end()));
+                    if (!destination.is_absolute() || std::filesystem::exists(destination)) throw std::runtime_error("Editor export requires a fresh absolute path");
+                    settle(*state, document, output);
+                    if (!document->pClass->saveAs(document, url.c_str(), format.c_str(), nullptr)) throw std::runtime_error("Editor export failed");
+                    if (std::filesystem::file_size(destination) > maxOutputBytes) { std::filesystem::remove(destination); throw std::runtime_error("Editor export exceeds output limit"); }
+                } else if (operation != "close") throw std::runtime_error("Unknown editor operation");
+                if (operation == "presentation" || operation == "presentationSurface") reportPresentation();
+                if (!state->commandFailure.empty()) throw std::runtime_error(state->commandFailure);
+                reply.put("ok", true);
+            } catch (const css::uno::Exception& error) { pixels.clear(); reply.put("ok", false); reply.put("error", OUStringToOString(error.Message, RTL_TEXTENCODING_UTF8)); }
+            catch (const std::exception& error) { pixels.clear(); reply.put("ok", false); reply.put("error", error.what()); }
+            modifications->suppressed = false;
+            reply.put("revision", modifications->revision);
+            flushEvents(*state, output);
+            const OString encoded = reply.finishAndGetAsOString();
+            if (static_cast<unsigned long long>(encoded.getLength()) > std::max<unsigned long long>(MaxControlBytes, maxOutputBytes)) {
+                tools::JsonWriter error;
+                error.put("kind", "reply"); error.put("id", id); error.put("ok", false);
+                error.put("error", "Editor response exceeds output limit"); error.put("revision", modifications->revision);
+                send(output, error);
+            } else send(output, encoded, pixels);
+            if (operation == "close") break;
+        }
+        stop();
+    } catch (...) { stop(); throw; }
+}
diff --git a/desktop/source/lib/dsh_frame_forwarding.h b/desktop/source/lib/dsh_frame_forwarding.h
new file mode 100644
index 000000000..9f456a082
--- /dev/null
+++ b/desktop/source/lib/dsh_frame_forwarding.h
@@ -0,0 +1,134 @@
+#ifndef DSH_FRAME_FORWARDING_H
+#define DSH_FRAME_FORWARDING_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define DSH_FRAME_FORWARDING_PROTOCOL_VERSION 1
+#define DSH_FRAME_FORWARDING_TEXT_CAPACITY 16384
+/** Opaque connected producer. One thread may poll while another acquires, writes,
+ * submits or discards. Callers must serialize use of the same graphics context.
+ */
+typedef struct dsh_frame_forwarding_client dsh_frame_forwarding_client;
+/** Pool-owned surface. Borrowed resources and imported objects are usable only
+ * during the acquisition; never destroy the SDK-owned resource.
+ */
+typedef struct dsh_frame_forwarding_surface dsh_frame_forwarding_surface;
+/** kind: 0 credit/timeout, 1 incoming JSON, -1 closed/error.
+ * Terminal events carry diagnostic text when available.
+ */
+typedef struct dsh_frame_forwarding_event { int kind; char text[DSH_FRAME_FORWARDING_TEXT_CAPACITY]; } dsh_frame_forwarding_event;
+/** Connect to a frame-forwarding channel with its TX credential, the opaque text the receiver issued. The credential
+ * names no producer process: any process holding a copy may connect, and a parent may hand it to the process it
+ * starts. The channel serves one connection at a time. While another producer is connected, connect fails with an
+ * error starting "channel-busy". After that producer disconnects, the first authenticated successor waits until the
+ * receiver has released every frame and resource of the previous connection; further candidates fail as busy.
+ * Without options the wait is unbounded. Receivers that predate transferable credentials, or that do not acknowledge
+ * that a producer names only handles of its own process, are refused.
+ */
+dsh_frame_forwarding_client* dsh_frame_forwarding_connect(const char* tx, char* error, size_t error_size);
+/** Connect using the application's ID3D11Device on Windows; NULL selects the default
+ * device. The client retains a device reference until close. macOS requires NULL.
+ * Serialize the device's immediate context with all SDK writes.
+ */
+dsh_frame_forwarding_client* dsh_frame_forwarding_connect_with_device(const char* tx, void* device, char* error, size_t error_size);
+/** Bounded connection options. cancelled is optional and runs on the connecting
+ * thread; its context must remain alive until connect_with_options returns.
+ */
+typedef struct dsh_frame_forwarding_connect_options {
+  void* device;
+  uint32_t timeout_ms;
+  void* cancellation_context;
+  int (*cancelled)(void*);
+} dsh_frame_forwarding_connect_options;
+/** Connect with a positive timeout and optional cancellation, which also bound waiting
+ * for the previous connection to drain. Device ownership and platform rules match connect_with_device.
+ */
+dsh_frame_forwarding_client* dsh_frame_forwarding_connect_with_options(const char* tx,
+  const dsh_frame_forwarding_connect_options* options, char* error, size_t error_size);
+/** Acquire BGRA8 premultiplied top-left pixels; NULL means allocation pending or no credit; poll reports terminal allocation errors.
+ * When no other surface of the size is free, the surface of an unsent submit_latest frame is reused and that frame is dropped.
+ */
+dsh_frame_forwarding_surface* dsh_frame_forwarding_acquire(dsh_frame_forwarding_client* client, uint32_t width, uint32_t height);
+/** Borrow an IOSurfaceRef (macOS) or ID3D11Texture2D* (Windows) while acquired.
+ * Windows external writers acquire/release key 0 around GPU commands (see
+ * surface_keyed_mutex); macOS writers complete GPU writes before submit/discard.
+ * Release imported objects/views before ending the acquisition.
+ */
+void* dsh_frame_forwarding_surface_native(dsh_frame_forwarding_surface* surface);
+/** Borrow the Windows shared NT handle while this surface is acquired; NULL on macOS.
+ * Do not close the borrowed handle. External imports must synchronize with key 0
+ * and release access and imported objects before submit/discard.
+ */
+void* dsh_frame_forwarding_surface_shared_handle(dsh_frame_forwarding_surface* surface);
+/** Return the ID3D11Device* borrowed until client close, or NULL on macOS.
+ * External GPU imports must use the same adapter as this device.
+ */
+void* dsh_frame_forwarding_device(dsh_frame_forwarding_client* client);
+/** Borrow the acquired Windows surface's IDXGIKeyedMutex, or NULL on macOS.
+ * acquire itself never locks. External writers acquire key 0 before issuing GPU
+ * commands and release key 0 before submit/discard, without waiting for completion.
+ * SDK write_bgra owns this lock; do not lock around that call.
+ * Do not release the borrowed COM reference. AcquireSync may block the CPU.
+ */
+void* dsh_frame_forwarding_surface_keyed_mutex(dsh_frame_forwarding_surface* surface);
+/** Copy CPU BGRA rows; return 1 on success, 0 on failure.
+ * Windows acquires key 0 with a 1000 ms timeout and releases it after enqueueing
+ * the upload. Input memory may be reused on return; GPU completion is asynchronous.
+ */
+int dsh_frame_forwarding_write_bgra(dsh_frame_forwarding_surface* surface, const void* pixels, size_t stride);
+/** CPU upload with a positive keyed-mutex acquisition timeout. Failure leaves completion
+ * uncertain; close the client without discarding or reusing the acquisition.
+ */
+int dsh_frame_forwarding_write_bgra_with_timeout(dsh_frame_forwarding_surface* surface, const void* pixels, size_t stride, uint32_t timeout_ms);
+/** Submit after Windows GPU writes are queued and the writer released key 0;
+ * macOS GPU writes must be complete. Release all imported objects/views first.
+ * frame_id must be 1..9007199254740991 and unique among outstanding submissions.
+ * Return 1 on submission; the surface cannot be reused until it is reacquired.
+ * Return 0 on failure; a valid acquisition stays with the caller for retry or discard.
+ */
+int dsh_frame_forwarding_submit(dsh_frame_forwarding_client* client, dsh_frame_forwarding_surface* surface, uint64_t frame_id, const char* metadata_json);
+/** Submit a continuous-stream frame without waiting for receiver credit, under the GPU
+ * ownership rules of submit. With N the receiver's frame limit, the frame is sent at once
+ * while fewer than max(1, N - 1) submissions await release; otherwise it becomes the client's
+ * single queued frame, and an older queued frame returns to the pool unsent. Polling that
+ * observes a release sends the queued frame, so the newest complete frame reaches the receiver
+ * without another render. Acquisition reuses the queued surface when no other surface of that
+ * size is free; with N of at least 2 an allocated stream always obtains a surface. The frame is
+ * marked replaceable, so a receiver that stages frames before presentation may drop it once a
+ * newer latest frame is ready; submit frames are never dropped.
+ * frame_id must be unique among outstanding submissions. Return 1 when sent or queued.
+ * Return 0 on failure; a valid acquisition stays with the caller for retry or discard.
+ */
+int dsh_frame_forwarding_submit_latest(dsh_frame_forwarding_client* client, dsh_frame_forwarding_surface* surface, uint64_t frame_id, const char* metadata_json);
+/** Return every idle surface to the receiver's byte budget: available surfaces, the queued submit_latest frame,
+ * granted allocations not yet created, and pending allocation requests. Acquired and submitted surfaces stay. A later
+ * acquire requests allocations again. Call it when the view stops displaying frames, for example after applying an
+ * invisible viewport. On Windows it flushes the D3D11 immediate context of the producer's device so the released
+ * textures are destroyed; call it on the thread that uses that context. Return 1 when every deallocation was sent; 0
+ * for a closed client, and then poll reports the error.
+ */
+int dsh_frame_forwarding_trim(dsh_frame_forwarding_client* client);
+/** Return an acquired, unsubmitted surface under the same GPU ownership rules as
+ * submit. If releasing GPU access failed, terminate the connection instead of
+ * discarding. The next writer must acquire key 0 even after a discard.
+ */
+void dsh_frame_forwarding_discard(dsh_frame_forwarding_client* client, dsh_frame_forwarding_surface* surface);
+/** Poll and apply credits; return event->kind. Only one thread may poll at a time.
+ * A negative result ends processing; preserve any diagnostic text before closing.
+ */
+int dsh_frame_forwarding_poll(dsh_frame_forwarding_client* client, uint32_t timeout_ms, dsh_frame_forwarding_event* event);
+/** Send application JSON to the receiver; never sends pixel bytes. */
+int dsh_frame_forwarding_send(dsh_frame_forwarding_client* client, const char* json);
+/** Interrupt polling without freeing client. Join polling thread before close. */
+void dsh_frame_forwarding_interrupt(dsh_frame_forwarding_client* client);
+/** Close this producer's connection after all its API calls have returned: no further operation is sent, unsubmitted
+ * and queued frames are dropped, and the receiver drains the frames it still holds before a successor holding the same
+ * TX credential becomes ready. Closing does not revoke other copies of the credential; only the receiver closes the
+ * channel. Receiver references stay valid. */
+void dsh_frame_forwarding_close(dsh_frame_forwarding_client* client);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/desktop/source/lib/dsh_frame_forwarding_producer.cxx b/desktop/source/lib/dsh_frame_forwarding_producer.cxx
new file mode 100644
index 000000000..cec4b755e
--- /dev/null
+++ b/desktop/source/lib/dsh_frame_forwarding_producer.cxx
@@ -0,0 +1,396 @@
+#include "transport.h"
+#include "producer-internal.h"
+#include <algorithm>
+#include <cstring>
+#include <vector>
+#include <limits>
+#include <chrono>
+#if defined(__APPLE__)
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOSurface/IOSurface.h>
+#include <unistd.h>
+#else
+#define NOMINMAX
+#include <windows.h>
+#include <d3d11_1.h>
+#include <dxgi1_2.h>
+#include <wrl/client.h>
+using Microsoft::WRL::ComPtr;
+#endif
+using namespace dsh_frame_forwarding;
+struct dsh_frame_forwarding_surface {
+  uint32_t width = 0, height = 0, stride = 0;
+  uint64_t bytes = 0, frame_id = 0, allocation_id = 0;
+  // A queued surface holds a complete latest-frame submission that waits for receiver credit.
+  enum { pending, granted, available, acquired, submitted, queued } state = pending;
+  std::string metadata;
+  dsh_frame_forwarding_client* owner = nullptr;
+#if defined(__APPLE__)
+  IOSurfaceRef surface = nullptr;
+  ~dsh_frame_forwarding_surface() { if (surface) CFRelease(surface); }
+#else
+  ComPtr<ID3D11Texture2D> texture;
+  ComPtr<IDXGIKeyedMutex> keyed_mutex;
+  HANDLE handle = nullptr;
+  ~dsh_frame_forwarding_surface() { if (handle) CloseHandle(handle); }
+#endif
+};
+struct dsh_frame_forwarding_client {
+  std::unique_ptr<Channel> channel;
+  std::mutex pool_mutex;
+  std::vector<std::unique_ptr<dsh_frame_forwarding_surface>> surfaces;
+  uint32_t max_frames = 0;
+  uint64_t max_bytes = 0, next_allocation = 1;
+  std::string error;
+  std::atomic<bool> stopped{false};
+#if defined(_WIN32)
+  ComPtr<ID3D11Device> device;
+  ComPtr<ID3D11DeviceContext> context;
+#endif
+};
+namespace {
+/** Send a complete surface, marked replaceable for a latest-frame submission; the caller holds pool_mutex. */
+bool send_frame(dsh_frame_forwarding_client* client, dsh_frame_forwarding_surface* surface, uint64_t frame_id, const char* metadata_json,
+    bool replaceable) {
+  Packet packet; packet.kind = frame; packet.max_frames = replaceable ? frame_replaceable : 0;
+  if (!metadata_json || std::strlen(metadata_json) >= sizeof(packet.text)) return false;
+  std::strcpy(packet.text, metadata_json);
+  packet.width = surface->width; packet.height = surface->height; packet.stride = surface->stride;
+  packet.frame_id = frame_id; packet.allocation_id = surface->allocation_id;
+#if defined(__APPLE__)
+  auto resource = reinterpret_cast<uintptr_t>(surface->surface);
+#else
+  auto resource = reinterpret_cast<uintptr_t>(surface->handle);
+#endif
+  if (!client->channel->send(packet, resource)) return false;
+  surface->frame_id = frame_id; surface->state = dsh_frame_forwarding_surface::submitted; return true;
+}
+/** Whether fewer submissions await release than the latest-frame limit, which leaves one surface with the producer. */
+bool latest_credit(const dsh_frame_forwarding_client* client) {
+  uint32_t outstanding = 0;
+  for (auto& surface : client->surfaces) if (surface->state == dsh_frame_forwarding_surface::submitted) ++outstanding;
+  return outstanding < std::max<uint32_t>(1, client->max_frames - 1);
+}
+/** Send the queued latest frame once credit allows; the caller holds pool_mutex. */
+void send_queued(dsh_frame_forwarding_client* client) {
+  if (!latest_credit(client)) return;
+  for (auto& surface : client->surfaces) {
+    if (surface->state != dsh_frame_forwarding_surface::queued) continue;
+    if (!send_frame(client, surface.get(), surface->frame_id, surface->metadata.c_str(), true)) client->error = "Frame-forwarding frame channel closed";
+    surface->metadata.clear(); return;
+  }
+}
+void copy_error(char* output, size_t size, const char* message) {
+  if (output && size) { std::strncpy(output, message, size - 1); output[size - 1] = 0; }
+}
+/**
+ * Return every surface that is neither acquired nor submitted to the receiver; the caller holds pool_mutex.
+ * @returns Whether every deallocation was sent.
+ */
+bool release_idle(dsh_frame_forwarding_client* client) {
+  bool sent = true;
+  client->surfaces.erase(std::remove_if(client->surfaces.begin(), client->surfaces.end(), [&](auto& surface) {
+    if (surface->state == dsh_frame_forwarding_surface::acquired || surface->state == dsh_frame_forwarding_surface::submitted) return false;
+    Packet packet; packet.kind = deallocate; packet.allocation_id = surface->allocation_id;
+    sent = client->channel->send(packet) && sent; return true;
+  }), client->surfaces.end());
+  return sent;
+}
+bool set_text(Packet& packet, const char* text) {
+  if (!text || std::strlen(text) >= sizeof(packet.text)) return false;
+  std::strcpy(packet.text, text); return true;
+}
+/** Diagnostic for a receiver's refusal; "channel-busy" names a channel whose producer is still connected or draining. */
+std::string refusal(const Packet& packet) {
+  const std::string reason(packet.text, strnlen(packet.text, sizeof(packet.text)));
+  if (reason == reject_busy) return "channel-busy: the frame-forwarding channel already has a producer or a waiting successor";
+  if (reason == reject_capability) return "Frame-forwarding receiver requires a transferable TX producer";
+  if (reason == reject_local_handles) return "Frame-forwarding receiver requires a producer that names only its own handles";
+  if (reason == reject_credential) return "Frame-forwarding TX credential was rejected";
+  if (reason == reject_closed) return "Frame-forwarding channel is closed";
+  if (reason.rfind(reject_protocol, 0) == 0) return "Frame-forwarding " + reason;
+  return "Frame-forwarding receiver rejected handshake";
+}
+#if defined(__APPLE__)
+void set_number(CFMutableDictionaryRef dictionary, CFStringRef key, int64_t value) {
+  auto number = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt64Type, &value);
+  CFDictionarySetValue(dictionary, key, number); CFRelease(number);
+}
+#endif
+}
+extern "C" {
+dsh_frame_forwarding_client* dsh_frame_forwarding_connect(const char* endpoint_text, char* error, size_t error_size) {
+  return dsh_frame_forwarding_connect_with_device(endpoint_text, nullptr, error, error_size);
+}
+static dsh_frame_forwarding_client* connect_impl(const char* endpoint_text, void* device,
+    const dsh_frame_forwarding_connect_options* options, char* error, size_t error_size) {
+  try {
+    if (!endpoint_text) throw std::runtime_error("Missing frame-forwarding TX credential");
+    auto endpoint = parse_endpoint(endpoint_text);
+    auto client = std::make_unique<dsh_frame_forwarding_client>();
+    const auto started = std::chrono::steady_clock::now();
+    const auto cancelled = [&] {
+      return options && ((options->cancelled && options->cancelled(options->cancellation_context)) ||
+        std::chrono::steady_clock::now() - started >= std::chrono::milliseconds(options->timeout_ms));
+    };
+    client->channel = connect_channel(endpoint, options ? std::function<bool()>(cancelled) : std::function<bool()>{});
+    Packet packet; packet.kind = hello; std::strcpy(packet.token, endpoint.token.c_str());
+#if defined(_WIN32)
+    if (device) {
+      client->device = static_cast<ID3D11Device*>(device);
+      client->device->GetImmediateContext(&client->context);
+    } else if (FAILED(D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+        nullptr, 0, D3D11_SDK_VERSION, &client->device, nullptr, &client->context)))
+      throw std::runtime_error("D3D11 hardware device unavailable");
+    set_text(packet, device_adapter(client->device.Get()).c_str());
+    packet.max_frames = hello_keyed_mutex | hello_transferable | hello_producer_local_handles;
+#else
+    if (device) throw std::runtime_error("IOSurface producer does not accept a graphics device");
+    packet.max_frames = hello_transferable | hello_producer_local_handles;
+#endif
+    if (!client->channel->send(packet)) throw std::runtime_error("Cannot send frame-forwarding handshake");
+    Received received;
+    int result;
+    do {
+      if (cancelled()) throw std::runtime_error("Frame-forwarding connection cancelled or timed out");
+      result = client->channel->receive(received, 100);
+    } while (result == 0);
+    const auto& reply = received.packet;
+    if (result < 0 || reply.marker != magic || reply.version != DSH_FRAME_FORWARDING_PROTOCOL_VERSION)
+      throw std::runtime_error("Frame-forwarding receiver rejected handshake");
+    if (reply.kind == goodbye) throw std::runtime_error(refusal(reply));
+    const auto connection = parse_connection(reply.token);
+    if (reply.kind != ready || !reply.max_frames || !reply.max_bytes) throw std::runtime_error("Frame-forwarding receiver rejected handshake");
+    // A receiver that predates transferable channels answers without a connection identifier.
+    if (!connection) throw std::runtime_error("Frame-forwarding receiver does not support transferable TX credentials");
+    // A receiver that does not echo the capability would read this producer's handle values as handles of its own.
+    if (!(reply.stride & hello_producer_local_handles)) throw std::runtime_error("Frame-forwarding receiver does not accept producer-local handles");
+    client->channel->bind_connection(connection);
+    client->max_frames = reply.max_frames; client->max_bytes = reply.max_bytes;
+    return client.release();
+  } catch (const std::exception& exception) { copy_error(error, error_size, exception.what()); return nullptr; }
+}
+dsh_frame_forwarding_client* dsh_frame_forwarding_connect_with_device(const char* endpoint, void* device, char* error, size_t error_size) {
+  return connect_impl(endpoint, device, nullptr, error, error_size);
+}
+dsh_frame_forwarding_client* dsh_frame_forwarding_connect_with_options(const char* endpoint,
+    const dsh_frame_forwarding_connect_options* options, char* error, size_t error_size) {
+  if (!options || !options->timeout_ms) { copy_error(error, error_size, "Connection requires a positive timeout"); return nullptr; }
+  return connect_impl(endpoint, options->device, options, error, error_size);
+}
+dsh_frame_forwarding_surface* dsh_frame_forwarding_acquire(dsh_frame_forwarding_client* client, uint32_t width, uint32_t height) {
+  if (!client || client->stopped) return nullptr;
+  std::lock_guard<std::mutex> lock(client->pool_mutex);
+  if (!width || !height || width > 16384 || height > 16384) { client->error = "Frame-forwarding dimensions outside supported range"; return nullptr; }
+  dsh_frame_forwarding_surface *granted_surface = nullptr, *queued_surface = nullptr;
+  bool allocation_pending = false;
+  for (auto& surface : client->surfaces) {
+    if (surface->width != width || surface->height != height) continue;
+    if (surface->state == dsh_frame_forwarding_surface::available) {
+      surface->state = dsh_frame_forwarding_surface::acquired; return surface.get();
+    }
+    if (surface->state == dsh_frame_forwarding_surface::pending) allocation_pending = true;
+    if (surface->state == dsh_frame_forwarding_surface::queued) queued_surface = surface.get();
+    if (surface->state == dsh_frame_forwarding_surface::granted && !granted_surface) granted_surface = surface.get();
+  }
+  // The newer frame rendered into an unsent latest submission replaces it.
+  if (!granted_surface && queued_surface) {
+    queued_surface->metadata.clear(); queued_surface->state = dsh_frame_forwarding_surface::acquired; return queued_surface;
+  }
+  if (!granted_surface && allocation_pending) return nullptr;
+  if (!granted_surface) {
+    release_idle(client);
+    uint64_t allocated_bytes = 0;
+    for (auto& surface : client->surfaces) allocated_bytes += surface->bytes;
+#if defined(__APPLE__)
+    auto row_bytes = IOSurfaceAlignProperty(kIOSurfaceBytesPerRow, static_cast<size_t>(width) * 4);
+    uint64_t required_bytes = IOSurfaceAlignProperty(kIOSurfaceAllocSize, row_bytes * height);
+    const uint64_t page_bytes = static_cast<uint64_t>(getpagesize());
+    required_bytes = (required_bytes + page_bytes - 1) / page_bytes * page_bytes;
+#else
+    uint64_t required_bytes = static_cast<uint64_t>(width) * height * 4;
+#endif
+    if (required_bytes > client->max_bytes) { client->error = "Frame-forwarding texture exceeds view byte budget"; return nullptr; }
+    if (client->surfaces.size() >= client->max_frames || allocated_bytes + required_bytes > client->max_bytes) return nullptr;
+    auto pending_surface = std::make_unique<dsh_frame_forwarding_surface>();
+    pending_surface->width = width; pending_surface->height = height; pending_surface->owner = client;
+    pending_surface->bytes = required_bytes; pending_surface->allocation_id = client->next_allocation++;
+    Packet request; request.kind = allocate; request.allocation_id = pending_surface->allocation_id; request.max_bytes = required_bytes;
+    if (!client->channel->send(request)) { client->error = "Frame-forwarding allocation channel closed"; return nullptr; }
+    client->surfaces.push_back(std::move(pending_surface)); return nullptr;
+  }
+  auto surface = granted_surface;
+#if defined(__APPLE__)
+  auto properties = CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+  set_number(properties, kIOSurfaceWidth, width); set_number(properties, kIOSurfaceHeight, height);
+  set_number(properties, kIOSurfaceAllocSize, surface->bytes);
+  set_number(properties, kIOSurfaceBytesPerElement, 4); set_number(properties, kIOSurfacePixelFormat, 0x42475241);
+  surface->surface = IOSurfaceCreate(properties); CFRelease(properties);
+  if (!surface->surface) { client->error = "IOSurface allocation failed"; return nullptr; }
+  surface->stride = static_cast<uint32_t>(IOSurfaceGetBytesPerRow(surface->surface));
+  surface->bytes = IOSurfaceGetAllocSize(surface->surface);
+#else
+  D3D11_TEXTURE2D_DESC desc{};
+  desc.Width = width; desc.Height = height; desc.MipLevels = 1; desc.ArraySize = 1;
+  desc.Format = DXGI_FORMAT_B8G8R8A8_UNORM; desc.SampleDesc.Count = 1;
+  desc.Usage = D3D11_USAGE_DEFAULT; desc.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+  desc.MiscFlags = D3D11_RESOURCE_MISC_SHARED_NTHANDLE | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX;
+  if (FAILED(client->device->CreateTexture2D(&desc, nullptr, &surface->texture))) { client->error = "D3D11 shared texture allocation failed"; return nullptr; }
+  if (FAILED(surface->texture.As(&surface->keyed_mutex))) { client->error = "DXGI producer keyed mutex unavailable"; return nullptr; }
+  ComPtr<IDXGIResource1> shared;
+  if (FAILED(surface->texture.As(&shared)) || FAILED(shared->CreateSharedHandle(nullptr, DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE, nullptr, &surface->handle))) { client->error = "DXGI shared handle creation failed"; return nullptr; }
+  surface->stride = width * 4; surface->bytes = static_cast<uint64_t>(width) * height * 4;
+#endif
+  surface->state = dsh_frame_forwarding_surface::acquired;
+  return surface;
+}
+void* dsh_frame_forwarding_surface_native(dsh_frame_forwarding_surface* surface) {
+  if (!surface) return nullptr;
+#if defined(__APPLE__)
+  return surface->surface;
+#else
+  return surface->texture.Get();
+#endif
+}
+void* dsh_frame_forwarding_surface_shared_handle(dsh_frame_forwarding_surface* surface) {
+#if defined(_WIN32)
+  return surface && surface->state == dsh_frame_forwarding_surface::acquired ? surface->handle : nullptr;
+#else
+  (void)surface; return nullptr;
+#endif
+}
+void* dsh_frame_forwarding_device(dsh_frame_forwarding_client* client) {
+#if defined(_WIN32)
+  return client ? client->device.Get() : nullptr;
+#else
+  (void)client; return nullptr;
+#endif
+}
+void* dsh_frame_forwarding_surface_keyed_mutex(dsh_frame_forwarding_surface* surface) {
+#if defined(_WIN32)
+  return surface && surface->state == dsh_frame_forwarding_surface::acquired ? surface->keyed_mutex.Get() : nullptr;
+#else
+  (void)surface; return nullptr;
+#endif
+}
+static int write_bgra(dsh_frame_forwarding_surface* surface, const void* pixels, size_t stride, uint32_t timeout_ms) {
+  if (!surface || !pixels || stride < static_cast<size_t>(surface->width) * 4 || stride > UINT32_MAX) return 0;
+  auto client = surface->owner; std::lock_guard<std::mutex> lock(client->pool_mutex);
+  if (surface->state != dsh_frame_forwarding_surface::acquired || client->stopped) return 0;
+#if defined(__APPLE__)
+  (void)timeout_ms;
+  if (IOSurfaceLock(surface->surface, 0, nullptr) != kIOReturnSuccess) return 0;
+  auto target = static_cast<unsigned char*>(IOSurfaceGetBaseAddress(surface->surface));
+  for (uint32_t row = 0; row < surface->height; ++row)
+    std::memcpy(target + static_cast<size_t>(row) * surface->stride, static_cast<const unsigned char*>(pixels) + static_cast<size_t>(row) * stride, surface->width * 4);
+  return IOSurfaceUnlock(surface->surface, 0, nullptr) == kIOReturnSuccess;
+#else
+  const auto acquired = surface->keyed_mutex->AcquireSync(0, timeout_ms);
+  if (acquired != S_OK) { client->error = "Producer write keyed mutex acquisition failed or timed out"; return 0; }
+  client->context->UpdateSubresource(surface->texture.Get(), 0, nullptr, pixels, static_cast<UINT>(stride), 0);
+  const auto released = surface->keyed_mutex->ReleaseSync(0);
+  client->context->Flush();
+  if (released != S_OK) { client->error = "Producer write keyed mutex release failed"; return 0; }
+  return 1;
+#endif
+}
+int dsh_frame_forwarding_write_bgra(dsh_frame_forwarding_surface* surface, const void* pixels, size_t stride) {
+  return write_bgra(surface, pixels, stride, 1000);
+}
+int dsh_frame_forwarding_write_bgra_with_timeout(dsh_frame_forwarding_surface* surface, const void* pixels, size_t stride, uint32_t timeout_ms) {
+  return timeout_ms ? write_bgra(surface, pixels, stride, timeout_ms) : 0;
+}
+int dsh_frame_forwarding_submit(dsh_frame_forwarding_client* client, dsh_frame_forwarding_surface* surface, uint64_t frame_id, const char* metadata_json) {
+  if (!client || !surface || surface->owner != client || !frame_id || frame_id > 9007199254740991ULL || client->stopped) return 0;
+  if (!metadata_json || std::strlen(metadata_json) >= DSH_FRAME_FORWARDING_TEXT_CAPACITY) return 0;
+  std::lock_guard<std::mutex> lock(client->pool_mutex);
+  if (surface->state != dsh_frame_forwarding_surface::acquired) return 0;
+  for (auto& other : client->surfaces) {
+    if ((other->state == dsh_frame_forwarding_surface::submitted || other->state == dsh_frame_forwarding_surface::queued)
+        && other->frame_id == frame_id) return 0;
+  }
+  return send_frame(client, surface, frame_id, metadata_json, false) ? 1 : 0;
+}
+int dsh_frame_forwarding_submit_latest(dsh_frame_forwarding_client* client, dsh_frame_forwarding_surface* surface, uint64_t frame_id, const char* metadata_json) {
+  if (!client || !surface || surface->owner != client || !frame_id || frame_id > 9007199254740991ULL || client->stopped) return 0;
+  if (!metadata_json || std::strlen(metadata_json) >= DSH_FRAME_FORWARDING_TEXT_CAPACITY) return 0;
+  std::lock_guard<std::mutex> lock(client->pool_mutex);
+  if (surface->state != dsh_frame_forwarding_surface::acquired) return 0;
+  for (auto& other : client->surfaces) if (other->state == dsh_frame_forwarding_surface::submitted && other->frame_id == frame_id) return 0;
+  // An unsent older latest frame returns to the pool; the receiver never saw it.
+  for (auto& other : client->surfaces) {
+    if (other->state != dsh_frame_forwarding_surface::queued) continue;
+    other->metadata.clear(); other->state = dsh_frame_forwarding_surface::available;
+  }
+  if (latest_credit(client)) return send_frame(client, surface, frame_id, metadata_json, true) ? 1 : 0;
+  try { surface->metadata = metadata_json; } catch (const std::bad_alloc&) { return 0; }
+  surface->frame_id = frame_id; surface->state = dsh_frame_forwarding_surface::queued; return 1;
+}
+int dsh_frame_forwarding_trim(dsh_frame_forwarding_client* client) {
+  if (!client || client->stopped) return 0;
+  std::lock_guard<std::mutex> lock(client->pool_mutex);
+  const bool sent = release_idle(client);
+#if defined(_WIN32)
+  // D3D11 destroys a released texture only when its context next flushes, which an idle producer would not do.
+  client->context->Flush();
+#endif
+  if (sent) return 1;
+  client->error = "Frame-forwarding allocation channel closed"; return 0;
+}
+void dsh_frame_forwarding_discard(dsh_frame_forwarding_client* client, dsh_frame_forwarding_surface* surface) {
+  if (!client || !surface || surface->owner != client) return;
+  std::lock_guard<std::mutex> lock(client->pool_mutex);
+  if (surface->state == dsh_frame_forwarding_surface::acquired) surface->state = dsh_frame_forwarding_surface::available;
+}
+int dsh_frame_forwarding_poll_activity(dsh_frame_forwarding_client* client, uint32_t timeout, dsh_frame_forwarding_event* event, bool* received_packet) {
+  *received_packet = false;
+  if (!client || !event) return -1;
+  event->kind = 0; event->text[0] = 0;
+  {
+    std::lock_guard<std::mutex> lock(client->pool_mutex);
+    if (!client->error.empty()) { event->kind = -1; copy_error(event->text, sizeof(event->text), client->error.c_str()); return -1; }
+  }
+  Received received;
+  auto result = client->channel->receive(received, std::min(timeout, 100U));
+  if (received.resource) release_resource(received.resource);
+  if (result < 0 || client->stopped) { event->kind = -1; return -1; }
+  if (!result) return 0;
+  *received_packet = true;
+  if (received.packet.marker != magic || received.packet.version != DSH_FRAME_FORWARDING_PROTOCOL_VERSION) { event->kind = -1; return -1; }
+  if (received.packet.kind == release) {
+    std::lock_guard<std::mutex> lock(client->pool_mutex);
+    for (auto& surface : client->surfaces) {
+      if (surface->state == dsh_frame_forwarding_surface::submitted && surface->frame_id == received.packet.frame_id) {
+        surface->state = dsh_frame_forwarding_surface::available; break;
+      }
+    }
+    send_queued(client);
+  } else if (received.packet.kind == allocated) {
+    std::lock_guard<std::mutex> lock(client->pool_mutex);
+    for (auto& surface : client->surfaces) {
+      if (surface->allocation_id == received.packet.allocation_id && surface->state == dsh_frame_forwarding_surface::pending) {
+        surface->state = dsh_frame_forwarding_surface::granted; break;
+      }
+    }
+  } else if (received.packet.kind == message && std::memchr(received.packet.text, 0, sizeof(received.packet.text))) {
+    event->kind = 1; std::strcpy(event->text, received.packet.text);
+  } else if (received.packet.kind == goodbye) { client->stopped = true; event->kind = -1; return -1; }
+  else { event->kind = -1; return -1; }
+  return event->kind;
+}
+int dsh_frame_forwarding_poll(dsh_frame_forwarding_client* client, uint32_t timeout, dsh_frame_forwarding_event* event) {
+  bool received;
+  return dsh_frame_forwarding_poll_activity(client, timeout, event, &received);
+}
+int dsh_frame_forwarding_send(dsh_frame_forwarding_client* client, const char* json) {
+  if (!client || client->stopped) return 0;
+  Packet packet; packet.kind = message;
+  return set_text(packet, json) && client->channel->send(packet);
+}
+void dsh_frame_forwarding_interrupt(dsh_frame_forwarding_client* client) { if (client) { client->stopped = true; client->channel->interrupt(); } }
+void dsh_frame_forwarding_close(dsh_frame_forwarding_client* client) {
+  if (!client) return;
+  Packet packet; packet.kind = goodbye; client->channel->send(packet);
+  dsh_frame_forwarding_interrupt(client); delete client;
+}
+}
