+        auto pUrl = static_cast<CFURLRef>(
+            CTFontDescriptorCopyAttribute(pDescriptor, kCTFontURLAttribute));
+        aFonts.emplace_back(GetOUString(pName),
+                            pUrl ? GetOUString(CFURLGetString(pUrl)) : OUString(), pFace);
+        if (pName)
+            CFRelease(pName);
+        if (pUrl)
+            CFRelease(pUrl);
     }
+    std::sort(aFonts.begin(), aFonts.end(), [](const auto& rLeft, const auto& rRight) {
+        return std::tie(std::get<0>(rLeft), std::get<1>(rLeft))
+             < std::tie(std::get<0>(rRight), std::get<1>(rRight));
