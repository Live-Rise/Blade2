{
  "name": "@deepseek-ai/libreoffice-kit",
  "description": "Convert, recalculate, and render Office documents with prebuilt LibreOffice",
  "version": "0.2.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepseek-ai/dsh-libreoffice-kit",
    "directory": "packages/entry"
  },
  "homepage": "https://github.com/deepseek-ai/dsh-libreoffice-kit",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cli": "./lib/cli.js",
    "./editor": {
      "types": "./lib/types/editor.d.ts",
      "default": "./lib/editor.js"
    },
    "./frame-forwarding": {
      "types": "./frame-forwarding/index.d.ts",
      "default": "./frame-forwarding/index.mjs"
    },
    "./frame-forwarding/sdk": "./frame-forwarding/sdk.json",
    "./frame-forwarding/verify": {
      "types": "./frame-forwarding/verify.d.mts",
      "default": "./frame-forwarding/verify.mjs"
    },
    "./frame-forwarding/browser": {
      "types": "./frame-forwarding/lib/browser/index.d.ts",
      "default": "./frame-forwarding/lib/browser/index.js"
    },
    "./frame-forwarding/electron": {
      "types": "./frame-forwarding/lib/electron/index.d.ts",
      "default": "./frame-forwarding/lib/electron/index.js"
    },
    "./frame-forwarding/electron/preload": {
      "types": "./frame-forwarding/lib/electron/preload.d.ts",
      "default": "./frame-forwarding/lib/electron/preload.js"
    }
  },
  "files": [
    "README.zh.md",
    "lib/index.js",
    "lib/cli.js",
    "lib/editor.js",
    "lib/worker.js",
    "lib/font-snapshot-worker.js",
    "NOTICE",
    "lib/types/**/*.d.ts",
    "frame-forwarding/index.mjs",
    "frame-forwarding/index.d.ts",
    "frame-forwarding/verify.mjs",
    "frame-forwarding/verify.d.mts",
    "frame-forwarding/receipt.json",
    "frame-forwarding/LICENSE",
    "frame-forwarding/README.md",
    "frame-forwarding/README.zh.md",
    "frame-forwarding/include/dsh_frame_forwarding.h",
    "frame-forwarding/src/graphite-interop-internal.hxx",
    "frame-forwarding/src/node-producer.cc",
    "frame-forwarding/src/producer-internal.h",
    "frame-forwarding/src/transport.h",
    "frame-forwarding/src/transport.cc",
    "frame-forwarding/src/relay-transport.inc",
    "frame-forwarding/src/producer.cc",
    "frame-forwarding/src/receiver.cc",
    "frame-forwarding/src/win-delay-load.cc",
    "frame-forwarding/src/win-delay-load.LICENSE",
    "frame-forwarding/src/graphite-interop.cc",
    "frame-forwarding/CMakeLists.txt",
    "frame-forwarding/sdk.json",
    "frame-forwarding/scripts/build.mjs",
    "frame-forwarding/scripts/metadata.mjs",
    "frame-forwarding/scripts/source-identity.mjs",
    "frame-forwarding/scripts/build-webgpu.mjs",
    "frame-forwarding/webgpu-dependencies.json",
    "frame-forwarding/scripts/verify-prebuilds.mjs",
    "frame-forwarding/prebuilds/darwin-arm64/frame-forwarding.node",
    "frame-forwarding/prebuilds/darwin-arm64/libdsh_frame_forwarding_sdk.a",
    "frame-forwarding/prebuilds/darwin-arm64/manifest.json",
    "frame-forwarding/prebuilds/darwin-x64/frame-forwarding.node",
    "frame-forwarding/prebuilds/darwin-x64/libdsh_frame_forwarding_sdk.a",
    "frame-forwarding/prebuilds/darwin-x64/manifest.json",
    "frame-forwarding/prebuilds/win32-x64/frame-forwarding.node",
    "frame-forwarding/prebuilds/win32-x64/dsh_frame_forwarding_sdk.lib",
    "frame-forwarding/prebuilds/win32-x64/manifest.json",
    "frame-forwarding/prebuilds/win32-arm64/frame-forwarding.node",
    "frame-forwarding/prebuilds/win32-arm64/dsh_frame_forwarding_sdk.lib",
    "frame-forwarding/prebuilds/win32-arm64/manifest.json",
    "frame-forwarding/lib/browser/index.js",
    "frame-forwarding/lib/browser/index.d.ts",
    "frame-forwarding/lib/browser/types.js",
    "frame-forwarding/lib/browser/types.d.ts",
    "frame-forwarding/lib/browser/painters.js",
    "frame-forwarding/lib/browser/painters.d.ts",
    "frame-forwarding/lib/browser/display.js",
    "frame-forwarding/lib/browser/display.d.ts",
    "frame-forwarding/lib/electron/index.js",
    "frame-forwarding/lib/electron/index.d.ts",
    "frame-forwarding/lib/electron/adapter.js",
    "frame-forwarding/lib/electron/adapter.d.ts",
    "frame-forwarding/lib/electron/transfer.js",
    "frame-forwarding/lib/electron/transfer.d.ts",
    "frame-forwarding/lib/electron/preload.js",
    "frame-forwarding/lib/electron/preload.d.ts"
  ],
  "dependencies": {
    "fflate": "0.8.2",
    "fontkit": "2.0.4",
    "saxes": "6.0.0"
  },
  "optionalDependencies": {
    "koffi": "3.1.1",
    "@deepseek-ai/libreoffice-kit-darwin-arm64": "0.2.3",
    "@deepseek-ai/libreoffice-kit-darwin-x64": "0.2.3",
    "@deepseek-ai/libreoffice-kit-wasm": "0.2.3",
    "@deepseek-ai/libreoffice-kit-win32-arm64": "0.2.3",
    "@deepseek-ai/libreoffice-kit-win32-x64": "0.2.3"
  },
  "bin": {
    "dsoffice": "./lib/cli.js"
  },
  "scripts": {}
}