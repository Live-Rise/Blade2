  "devDependencies": {
    "@deepseek-ai/dsh-compaction": "0.1.7-rc.2",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.1.7-rc.2",
